@model List<PurchaseRequisitionSystem.Models.PurchaseRequisition>

@{
    ViewData["Title"] = "My Purchase Requisitions";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>My Purchase Requisitions</h2>
        <a href="@Url.Action("Create")" class="btn btn-primary">
            <i class="fas fa-plus"></i> Create New PR
        </a>
    </div>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>PR Number</th>
                        <th>Facility</th>
                        <th>Request Type</th>
                        <th>Expense Type</th>
                        <th>Item Description</th>
                        <th>Cost</th>
                        <th>Status</th>
                        <th>Current Approver</th>
                        <th>Created Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pr in Model)
                    {
                        <tr>
                            <td>
                                <strong>@pr.PRNumber</strong>
                            </td>
                            <td>@pr.Facility.Name</td>
                            <td>
                                <span class="badge bg-info">@pr.RequestType</span>
                            </td>
                            <td>
                                <span class="badge bg-@(pr.ExpenseType == PurchaseRequisitionSystem.Models.ExpenseType.CAPEX ? "warning" : "secondary")">
                                    @pr.ExpenseType
                                </span>
                            </td>
                            <td>
                                @pr.ItemDescription
                                @if (pr.OpexCategory.HasValue)
                                {
                                    <br><small class="text-muted">(@pr.OpexCategory)</small>
                                }
                            </td>
                            <td>@pr.CostEstimation.ToString("C")</td>
                            <td>
                                <span class="badge bg-@(GetStatusBadgeColor(pr.CurrentStatus))">
                                    @GetStatusDisplayText(pr.CurrentStatus)
                                </span>
                            </td>
                            <td>
                                @if (pr.CurrentApprover != null)
                                {
                                    @pr.CurrentApprover.FullName
                                }
                                else if (pr.CurrentStatus == PurchaseRequisitionSystem.Models.ApprovalStatus.Approved)
                                {
                                    <span class="text-success">Completed</span>
                                }
                                else if (pr.CurrentStatus == PurchaseRequisitionSystem.Models.ApprovalStatus.Rejected)
                                {
                                    <span class="text-danger">Rejected</span>
                                }
                            </td>
                            <td>@pr.CreatedDate.ToString("MMM dd, yyyy")</td>
                            <td>
                                <a href="@Url.Action("Details", new { id = pr.Id })" 
                                   class="btn btn-sm btn-outline-primary" 
                                   title="View Details">
                                    <i class="fas fa-eye"></i>
                                </a>
                                @if (pr.CurrentStatus == PurchaseRequisitionSystem.Models.ApprovalStatus.Clarification)
                                {
                                    <a href="@Url.Action("Edit", new { id = pr.Id })" 
                                       class="btn btn-sm btn-outline-warning" 
                                       title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-clipboard-list fa-5x text-muted mb-3"></i>
            <h4 class="text-muted">No Purchase Requisitions Found</h4>
            <p class="text-muted">You haven't created any purchase requisitions yet.</p>
            <a href="@Url.Action("Create")" class="btn btn-primary">
                <i class="fas fa-plus"></i> Create Your First PR
            </a>
        </div>
    }
</div>

@functions {
    private string GetStatusBadgeColor(PurchaseRequisitionSystem.Models.ApprovalStatus status)
    {
        return status switch
        {
            PurchaseRequisitionSystem.Models.ApprovalStatus.Approved => "success",
            PurchaseRequisitionSystem.Models.ApprovalStatus.Rejected => "danger",
            PurchaseRequisitionSystem.Models.ApprovalStatus.Initiated => "info",
            PurchaseRequisitionSystem.Models.ApprovalStatus.Clarification => "warning",
            _ => "secondary"
        };
    }

    private string GetStatusDisplayText(PurchaseRequisitionSystem.Models.ApprovalStatus status)
    {
        return status switch
        {
            PurchaseRequisitionSystem.Models.ApprovalStatus.PendingHODInitiator => "Pending HOD (Initiator)",
            PurchaseRequisitionSystem.Models.ApprovalStatus.PendingHODDepartment => "Pending HOD (Department)",
            PurchaseRequisitionSystem.Models.ApprovalStatus.PendingFinance => "Pending Finance",
            PurchaseRequisitionSystem.Models.ApprovalStatus.PendingWarehouse => "Pending Warehouse",
            PurchaseRequisitionSystem.Models.ApprovalStatus.PendingSCM => "Pending SCM",
            PurchaseRequisitionSystem.Models.ApprovalStatus.PendingDirector => "Pending Director",
            PurchaseRequisitionSystem.Models.ApprovalStatus.PendingCFO => "Pending CFO",
            PurchaseRequisitionSystem.Models.ApprovalStatus.PendingCEO => "Pending CEO",
            _ => status.ToString()
        };
    }
}