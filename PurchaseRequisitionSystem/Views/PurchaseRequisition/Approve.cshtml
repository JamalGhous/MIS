@model PurchaseRequisitionSystem.ViewModels.ApprovalActionViewModel

@{
    ViewData["Title"] = "Approve Purchase Requisition";
}

<div class="container">
    <div class="row mb-4">
        <div class="col-md-12">
            <h2>Review Purchase Requisition</h2>
            <hr />
        </div>
    </div>

    <!-- PR Summary -->
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-file-alt"></i> @Model.PurchaseRequisition.PRNumber
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>Initiator:</strong> @Model.PurchaseRequisition.Initiator.FullName</p>
                            <p><strong>Facility:</strong> @Model.PurchaseRequisition.Facility.Name</p>
                            <p><strong>Department:</strong> @Model.PurchaseRequisition.Department</p>
                            <p><strong>Request Type:</strong> @Model.PurchaseRequisition.RequestType</p>
                            <p><strong>Expense Type:</strong> @Model.PurchaseRequisition.ExpenseType</p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>Item:</strong> @Model.PurchaseRequisition.ItemDescription</p>
                            <p><strong>Quantity:</strong> @Model.PurchaseRequisition.Quantity @Model.PurchaseRequisition.UnitOfMeasure</p>
                            <p><strong>Cost Estimation:</strong> <span class="h5 text-success">@Model.PurchaseRequisition.CostEstimation.ToString("C")</span></p>
                            <p><strong>Budgeted:</strong> 
                                <span class="badge bg-@(Model.PurchaseRequisition.IsBudgeted ? "success" : "warning")">
                                    @(Model.PurchaseRequisition.IsBudgeted ? "Yes" : "No")
                                </span>
                            </p>
                        </div>
                    </div>
                    
                    <div class="row mt-3">
                        <div class="col-md-12">
                            <h6>Specification:</h6>
                            <p>@Model.PurchaseRequisition.Specification</p>
                            
                            @if (!string.IsNullOrEmpty(Model.PurchaseRequisition.Justification))
                            {
                                <h6>Justification:</h6>
                                <p>@Model.PurchaseRequisition.Justification</p>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Approval Action Form -->
    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-user-check"></i> Approval Action</h5>
                </div>
                <div class="card-body">
                    <form asp-action="ProcessApproval" method="post" enctype="multipart/form-data" id="approvalForm">
                        <input asp-for="PurchaseRequisitionId" type="hidden" />
                        
                        <div class="form-group mb-3">
                            <label class="form-label">Select Action:</label>
                            <div class="btn-group-toggle" data-toggle="buttons">
                                <div class="row">
                                    <div class="col-md-3">
                                        <input type="radio" asp-for="Action" value="approve" class="btn-check" id="btnApprove" />
                                        <label class="btn btn-outline-success btn-lg w-100" for="btnApprove">
                                            <i class="fas fa-check"></i><br>Approve
                                        </label>
                                    </div>
                                    <div class="col-md-3">
                                        <input type="radio" asp-for="Action" value="reject" class="btn-check" id="btnReject" />
                                        <label class="btn btn-outline-danger btn-lg w-100" for="btnReject">
                                            <i class="fas fa-times"></i><br>Reject
                                        </label>
                                    </div>
                                    <div class="col-md-3">
                                        <input type="radio" asp-for="Action" value="delegate" class="btn-check" id="btnDelegate" />
                                        <label class="btn btn-outline-warning btn-lg w-100" for="btnDelegate">
                                            <i class="fas fa-user-friends"></i><br>Delegate
                                        </label>
                                    </div>
                                    <div class="col-md-3">
                                        <input type="radio" asp-for="Action" value="clarification" class="btn-check" id="btnClarification" />
                                        <label class="btn btn-outline-info btn-lg w-100" for="btnClarification">
                                            <i class="fas fa-question-circle"></i><br>Clarification
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Comments" class="form-label">Comments:</label>
                            <textarea asp-for="Comments" class="form-control" rows="4" placeholder="Enter your comments here..."></textarea>
                        </div>

                        <!-- Rejection Reason (shown when Reject is selected) -->
                        <div class="form-group mb-3" id="rejectionReasonDiv" style="display:none;">
                            <label asp-for="RejectionReason" class="form-label">Rejection Reason: <span class="text-danger">*</span></label>
                            <textarea asp-for="RejectionReason" class="form-control" rows="3" placeholder="Please provide a reason for rejection..."></textarea>
                            <span asp-validation-for="RejectionReason" class="text-danger"></span>
                        </div>

                        <!-- Delegate User Selection (shown when Delegate is selected) -->
                        <div class="form-group mb-3" id="delegateUserDiv" style="display:none;">
                            <label asp-for="DelegateToUserId" class="form-label">Delegate To: <span class="text-danger">*</span></label>
                            <select asp-for="DelegateToUserId" class="form-select">
                                <option value="">-- Select User --</option>
                                @foreach (var user in Model.DelegateUsers)
                                {
                                    <option value="@user.Id">@user.FullName (@user.Department)</option>
                                }
                            </select>
                            <span asp-validation-for="DelegateToUserId" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Attachments" class="form-label">Additional Attachments (Optional):</label>
                            <input asp-for="Attachments" class="form-control" type="file" multiple accept=".pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg" />
                            <div class="form-text">You can upload supporting documents</div>
                        </div>

                        <div class="form-group">
                            <button type="submit" class="btn btn-primary btn-lg" id="submitBtn" disabled>
                                <i class="fas fa-paper-plane"></i> Submit Action
                            </button>
                            <a asp-action="Details" asp-route-id="@Model.PurchaseRequisitionId" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Back to Details
                            </a>
                            <a asp-action="Dashboard" asp-controller="Home" class="btn btn-outline-secondary">
                                <i class="fas fa-tachometer-alt"></i> Dashboard
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Quick Reference -->
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-info-circle"></i> Quick Reference</h5>
                </div>
                <div class="card-body">
                    <h6>Action Guidelines:</h6>
                    <ul class="list-unstyled">
                        <li><strong><i class="fas fa-check text-success"></i> Approve:</strong> Move to next approval level</li>
                        <li><strong><i class="fas fa-times text-danger"></i> Reject:</strong> Permanently reject the request</li>
                        <li><strong><i class="fas fa-user-friends text-warning"></i> Delegate:</strong> Transfer approval to another user</li>
                        <li><strong><i class="fas fa-question-circle text-info"></i> Clarification:</strong> Send back to initiator for more information</li>
                    </ul>
                    
                    <hr>
                    
                    <h6>Approval Hierarchy:</h6>
                    <ol class="small">
                        <li>HOD (Initiator)</li>
                        <li>HOD (Department)</li>
                        <li>Finance</li>
                        <li>Warehouse</li>
                        <li>SCM</li>
                        <li>Director</li>
                        <li>CFO</li>
                        <li>CEO</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const actionButtons = document.querySelectorAll('input[name="Action"]');
            const rejectionDiv = document.getElementById('rejectionReasonDiv');
            const delegateDiv = document.getElementById('delegateUserDiv');
            const submitBtn = document.getElementById('submitBtn');
            
            actionButtons.forEach(function(button) {
                button.addEventListener('change', function() {
                    const action = this.value;
                    
                    // Hide all conditional divs first
                    rejectionDiv.style.display = 'none';
                    delegateDiv.style.display = 'none';
                    
                    // Show relevant div based on action
                    if (action === 'reject') {
                        rejectionDiv.style.display = 'block';
                    } else if (action === 'delegate') {
                        delegateDiv.style.display = 'block';
                    }
                    
                    // Enable submit button
                    submitBtn.disabled = false;
                    
                    // Update submit button text
                    const actionText = this.nextElementSibling.textContent.trim();
                    submitBtn.innerHTML = '<i class="fas fa-paper-plane"></i> ' + actionText;
                });
            });
            
            // Form validation
            document.getElementById('approvalForm').addEventListener('submit', function(e) {
                const selectedAction = document.querySelector('input[name="Action"]:checked');
                
                if (!selectedAction) {
                    alert('Please select an action.');
                    e.preventDefault();
                    return;
                }
                
                if (selectedAction.value === 'reject') {
                    const rejectionReason = document.querySelector('textarea[name="RejectionReason"]').value;
                    if (!rejectionReason.trim()) {
                        alert('Please provide a rejection reason.');
                        e.preventDefault();
                        return;
                    }
                }
                
                if (selectedAction.value === 'delegate') {
                    const delegateUser = document.querySelector('select[name="DelegateToUserId"]').value;
                    if (!delegateUser) {
                        alert('Please select a user to delegate to.');
                        e.preventDefault();
                        return;
                    }
                }
                
                // Confirm action
                const actionText = selectedAction.nextElementSibling.textContent.trim();
                if (!confirm(`Are you sure you want to ${actionText.toLowerCase()} this purchase requisition?`)) {
                    e.preventDefault();
                }
            });
        });
    </script>
}